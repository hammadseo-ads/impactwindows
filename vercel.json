{
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "rewrites": [
    { "source": "/thank-you", "destination": "/thank-you/index.html" },
    { "source": "/thank-you/", "destination": "/thank-you/index.html" },
    { "source": "/hurricane-windows", "destination": "/hurricane-windows/index.html" },
    { "source": "/hurricane-windows/", "destination": "/hurricane-windows/index.html" },
    { "source": "/impact-doors", "destination": "/impact-doors/index.html" },
    { "source": "/impact-doors/", "destination": "/impact-doors/index.html" },
    { "source": "/impact-windows", "destination": "/impact-windows/index.html" },
    { "source": "/impact-windows/", "destination": "/impact-windows/index.html" },
    { "source": "/replacement-windows", "destination": "/replacement-windows/index.html" },
    { "source": "/replacement-windows/", "destination": "/replacement-windows/index.html" },
    { "source": "/window-company", "destination": "/window-company/index.html" },
    { "source": "/window-company/", "destination": "/window-company/index.html" },
    { "source": "/storm-windows", "destination": "/storm-windows/index.html" },
    { "source": "/storm-windows/", "destination": "/storm-windows/index.html" },
    { "source": "/usahi", "destination": "/usahi/index.html" },
    { "source": "/usahi/", "destination": "/usahi/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/videos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    }
  ]
}
